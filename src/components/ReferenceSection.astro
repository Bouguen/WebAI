---
import {atlas,localized as L} from '../data/atlas.js';
import {dossiers} from '../data/dossiers.js';
import {referenceNav,referencePillars,technologyGroups,standardsRegister,ecosystemActors,referenceTimeline,referenceFaq,referenceResearchers} from '../data/referenceContent.js';
const {lang='fr',type='concept'}=Astro.props;
const fr=lang==='fr';
const configs={
 concept:{num:'01',eyebrow:'LE WEBAI · VISION & PÉRIMÈTRE',enEyebrow:'WEBAI · VISION & SCOPE',title:{fr:'Le Web généré par et pour l’IA.',en:'The Web generated by and for AI.'},intro:{fr:'Une cartographie des transformations du Web : production de contenus, recherche augmentée, interaction avec des agents et gouvernance des preuves. Il ne s’agit ni d’un nouveau protocole universel ni d’un organisme de normalisation.',en:'A map of changes to the Web: content generation, augmented search, agent interaction and evidence governance. This is neither a universal new protocol nor a standards body.'}},
 technologies:{num:'02',eyebrow:'L’ARCHITECTURE TECHNOLOGIQUE',enEyebrow:'THE TECHNOLOGY LANDSCAPE',title:{fr:'Les technologies qui transforment le Web.',en:'The technologies reshaping the Web.'},intro:{fr:'Du modèle génératif aux données liées, des agents aux moteurs de recherche : sept familles technologiques à consulter avec leurs dossiers et outils connexes.',en:'From generative models to linked data, agents and search systems: seven technical families connected to dossiers and tools.'}},
 standards:{num:'03',eyebrow:'STANDARDISATION & INTEROPÉRABILITÉ',enEyebrow:'STANDARDS & INTEROPERABILITY',title:{fr:'Standards, protocoles et propositions.',en:'Standards, protocols and proposals.'},intro:{fr:'Un registre différenciant standard publié, protocole versionné et brouillon expérimental. Chaque référence renvoie au document source et rappelle que la compatibilité réelle dépend des implémentations.',en:'A register distinguishing published standards, versioned protocols and experimental drafts. Each entry links to its original document; real support depends on implementations.'}},
 acteurs:{num:'04',eyebrow:'ORGANISMES & ÉCOSYSTÈMES',enEyebrow:'ORGANIZATIONS & ECOSYSTEM',title:{fr:'Les acteurs du Web de l’IA.',en:'The organizations shaping the AI Web.'},intro:{fr:'Normalisation, développement de protocoles, publication de modèles, recherche, mesure et sécurité. Les organismes sont présentés selon leur rôle documenté, sans leur attribuer un soutien à WebAI.',en:'Standards, protocols, model distribution, research, evaluation and security. Organizations are described by their documented roles, without implying endorsement of WebAI.'}},
 chronologie:{num:'05',eyebrow:'HISTOIRE & ÉVOLUTION',enEyebrow:'HISTORY & EVOLUTION',title:{fr:'Chronologie du Web et de l’IA.',en:'A timeline of the Web and AI.'},intro:{fr:'Des fondements du Web à l’arrivée des modèles génératifs, des protocoles d’agents et des propositions d’API du navigateur. Les dates d’annonce ne doivent pas être confondues avec une adoption universelle.',en:'From Web foundations to generative models, agent protocols and browser API proposals. Announcement dates do not imply universal adoption.'}},
 faq:{num:'06',eyebrow:'QUESTIONS & RÉPONSES SOURCÉES',enEyebrow:'EVIDENCE-LED QUESTIONS',title:{fr:'Questions essentielles sur le WebAI.',en:'Essential questions about the AI Web.'},intro:{fr:'Des réponses précises sur les concepts, normes, robots, modèles, agents, provenance et recherche. Chaque réponse renvoie à une source primaire pour approfondir ou contester la synthèse.',en:'Clear answers on concepts, standards, crawlers, models, agents, provenance and search. Each answer links to primary evidence for further scrutiny.'}}
};
const c=configs[type];
const topic=slug=>atlas.topics.find(t=>t.slug===slug);
const tool=slug=>atlas.catalog.find(t=>t.slug===slug);
const labelSources=fr?'Texte officiel ou original':'Original or official source';
const labelDossier=fr?'Lire le dossier de référence':'Read reference dossier';
---
<section class="ref-hero">
 <div class="wrap">
  <nav class="atlas-breadcrumb" aria-label={fr?'Fil d’Ariane':'Breadcrumb'}><a href={'/'+lang+'/'}>WebAI</a><span>/</span><span>{L(c.title,lang)}</span></nav>
  <div class="ref-hero-grid">
   <div>
    <span class="eyebrow"><span class="atlas-beacon"></span>{fr?c.eyebrow:c.enEyebrow}</span>
    <h1>{L(c.title,lang)}</h1>
    <p>{L(c.intro,lang)}</p>
    <div class="ref-hero-actions">
     <a class="atlas-pill-cta" href={'/'+lang+'/encyclopedie/'}>{fr?'Consulter l’encyclopédie':'Browse the encyclopedia'} ↗</a>
     <a class="ref-subtle-link" href={'/'+lang+'/ressources/'}>{fr?'Accéder aux sources':'Open primary sources'} ↗</a>
    </div>
   </div>
   <div class="ref-hero-emblem" aria-hidden="true"><small>WEBAI REFERENCE SYSTEM</small><strong>{c.num}</strong><span>{type.toUpperCase()}</span></div>
  </div>
 </div>
</section>
<div class="wrap ref-breadcrumb-links" aria-label={fr?'Rubriques de référence':'Reference sections'}>
 {referenceNav.filter(item=>item.id!=='outils'&&item.id!=='secteurs'&&item.id!=='publications'&&item.id!=='observatoire').map(item=><a href={'/'+lang+'/'+item.id+'/'} aria-current={item.id===type?'page':undefined}>{L(item.title,lang)}</a>)}
 <a href={'/'+lang+'/chronologie/'} aria-current={type==='chronologie'?'page':undefined}>{fr?'Chronologie':'Timeline'}</a>
 <a href={'/'+lang+'/faq/'} aria-current={type==='faq'?'page':undefined}>FAQ</a>
</div>
{type==='concept' && <section class="ref-body section"><div class="wrap">
 <div class="ref-section-heading"><span class="eyebrow">01 / {fr?'UNE TAXONOMIE DE RÉFÉRENCE':'A REFERENCE TAXONOMY'}</span>
  <h2>{fr?'Un Web. Quatre transformations complémentaires.':'One Web. Four connected transformations.'}</h2>
  <p>{fr?'La production artificielle de contenus, la découverte de connaissances, l’exécution d’actions et la confiance numérique sont des dimensions distinctes. Une même application peut en combiner plusieurs ; aucune ne remplace le HTML, les URL ou les standards existants.':'AI-assisted content production, knowledge discovery, agent actions and digital trust are distinct dimensions. A single application may combine them; none replaces HTML, URLs or existing Web standards.'}</p></div>
 <div class="ref-pillars">{referencePillars.map(p=><article class="ref-pillar">
    <div class="ref-pillar-top"><span>{p.num}</span><span>{L(p.tag,lang)}</span></div>
    <h3>{L(p.name,lang)}</h3><p>{L(p.description,lang)}</p>
    <div class="ref-topic-links">{p.topics.map(slug=>{const t=topic(slug);return t?<a href={'/'+lang+'/encyclopedie/'+slug+'/'}>{L(t.title,lang)} ↗</a>:null})}</div>
    <a class="ref-primary-source" href={p.source} target="_blank" rel="noopener noreferrer">{labelSources} ↗</a>
 </article>)}</div>
 <div class="ref-thesis">
  <span class="eyebrow">{fr?'LE PÉRIMÈTRE DE WEBAI':'WEBAI SCOPE'}</span>
  <h2>{fr?'Une référence indépendante, pas une norme revendiquée.':'An independent reference, not a claimed standard.'}</h2>
  <p>{fr?'WebAI propose une lecture documentée des changements qui touchent le Web. La présence de groupes de travail du W3C, de spécifications ou de projets industriels fournit des références d’étude ; elle ne fait pas de ce portail un représentant de ces organismes. Les standards sont décrits par leur statut et les expérimentations restent signalées.':'WebAI offers a source-led interpretation of changes affecting the Web. W3C groups, specifications and industrial projects are relevant sources; their inclusion does not make this portal their representative. Standards are described according to their documented status and experiments stay clearly labeled.'}</p>
  <div class="ref-thesis-actions"><a href={'/'+lang+'/methodologie/'}>{fr?'Politique éditoriale et vérification':'Editorial policy and verification'} ↗</a><a href="https://www.w3.org/groups/ig/webai/" target="_blank" rel="noopener noreferrer">{fr?'Groupe Web & AI du W3C':'W3C Web & AI Interest Group'} ↗</a></div>
 </div>
 </div></section>}
{type==='technologies' && <section class="ref-body section"><div class="wrap">
 <div class="ref-section-heading"><span class="eyebrow">{fr?'ATLAS DES TECHNOLOGIES':'TECHNOLOGY ATLAS'}</span><h2>{fr?'Sept familles. Des mécanismes et des dépendances.':'Seven families. Mechanisms and dependencies.'}</h2><p>{fr?'Chaque famille donne accès aux fiches techniques, outils spécialisés et documentations déjà rassemblés dans WebAI.':'Each family links to technical dossiers, specialized tools and documentation already curated by WebAI.'}</p></div>
 <div class="ref-tech-grid">{technologyGroups.map(group=><article class="ref-tech-card">
   <div class="ref-tech-index"><span>{group.num}</span><span>{group.id.toUpperCase()}</span></div><h3>{L(group.title,lang)}</h3><p>{L(group.description,lang)}</p>
   <div class="ref-tech-detail"><h4>{fr?'Dossiers clés':'Key dossiers'}</h4>
    {group.topics.map(slug=>{const t=topic(slug);return t?<a href={'/'+lang+'/encyclopedie/'+slug+'/'}><span>◇</span>{L(t.title,lang)} ↗</a>:null})}
   </div><div class="ref-tech-detail"><h4>{fr?'Outils et plateformes':'Tools and platforms'}</h4>
    {group.tools.map(slug=>{const x=tool(slug);return x?<a href={'/'+lang+'/outils/'+slug+'/'}><span>◈</span>{x.name} ↗</a>:null})}
   </div>
 </article>)}</div>
 </div></section>}
{type==='standards' && <section class="ref-body section"><div class="wrap">
 <div class="ref-section-heading"><span class="eyebrow">{fr?'REGISTRE DES SPÉCIFICATIONS':'SPECIFICATION REGISTER'}</span><h2>{fr?'Statut, organisme et rôle : chaque distinction compte.':'Status, organization and scope all matter.'}</h2>
 <p>{fr?'Le statut affiché reflète la publication de référence consultée pour cette édition. Les spécifications et les implémentations évoluent : ouvrez le document original pour vérifier la version actuellement en vigueur.':'The stated status reflects the referenced document for this edition. Specifications and implementations evolve: open the original to verify the currently applicable version.'}</p></div>
 <div class="ref-standards-key"><span>{fr?'Standard publié':'Published standard'}</span><span>{fr?'Protocole ou spécification versionné':'Versioned protocol / specification'}</span><span>{fr?'Projet ou brouillon':'Draft / proposal'}</span></div>
 <div class="ref-standard-list">{standardsRegister.map((s,index)=><article class="ref-standard" id={'std-'+index}>
   <div class="ref-standard-top"><span class="ref-number">{String(index+1).padStart(2,'0')}</span><span class:list={['ref-standard-status',s.statusId]}>{L(s.status,lang)}</span></div>
   <div class="ref-standard-grid"><div><h3>{s.name}</h3><small>{s.owner}</small><p>{L(s.scope,lang)}</p></div><div class="ref-standard-links">
    <a href={s.url} target="_blank" rel="noopener noreferrer">{fr?'Spécification officielle':'Original specification'} ↗</a>
    {s.topics.map(slug=>{const t=topic(slug);return t?<a href={'/'+lang+'/encyclopedie/'+slug+'/'}>{L(t.title,lang)} ↗</a>:null})}
   </div></div>
 </article>)}</div>
 <p class="ref-disclaimer">{fr?'Avertissement : une spécification ouverte n’assure pas à elle seule une compatibilité universelle, une conformité de sécurité ou un soutien institutionnel à WebAI.':'Notice: an open specification does not by itself ensure universal interoperability, security compliance or institutional endorsement of WebAI.'}</p>
 </div></section>}
{type==='acteurs' && <section class="ref-body section"><div class="wrap">
 <div class="ref-section-heading"><span class="eyebrow">{fr?'CARTE DES ORGANISATIONS':'ORGANIZATION MAP'}</span>
  <h2>{fr?'Qui produit les standards, les outils et les méthodes ?':'Who develops the standards, tools and methods?'}</h2>
  <p>{fr?'Un annuaire des acteurs de l’écosystème, classés par leur contribution documentée. La présence d’une organisation ne présume ni affiliation, ni partenariat, ni soutien au portail.':'A directory of ecosystem contributors described by documented activity. Listing an organization implies no affiliation, partnership or endorsement.'}</p></div>
 <div class="ref-actors">{ecosystemActors.map((actor,index)=><article class="ref-actor">
   <div class="ref-actor-top"><span>{String(index+1).padStart(2,'0')}</span><span>{L(actor.kind,lang)}</span></div>
   <h3>{actor.name}</h3><p>{L(actor.scope,lang)}</p>
   <div class="ref-actor-bottom"><a href={actor.url} target="_blank" rel="noopener noreferrer">{fr?'Site ou documentation d’origine':'Official site or documentation'} ↗</a>
   <a href={'/'+lang+'/encyclopedie/'+actor.topic+'/'}>{fr?'Notion associée':'Related dossier'} ↗</a></div>
 </article>)}</div>

 <div class="ref-researchers">
  <div class="ref-section-heading">
   <span class="eyebrow">{fr?'CHERCHEURS ET PUBLICATIONS FONDATRICES':'RESEARCHERS AND FOUNDATIONAL PAPERS'}</span>
   <h2>{fr?'Identifier les contributions, pas inventer des affiliations.':'Trace contributions, not invented affiliations.'}</h2>
   <p>{fr?'Ces travaux illustrent plusieurs étapes historiques de la recherche. Les noms correspondent aux auteurs cités ; aucune participation ou approbation de WebAI n’est suggérée.':'These papers illustrate several historical research milestones. Names refer to credited authors; no involvement with or endorsement of WebAI is implied.'}</p>
  </div>
  <div class="ref-researchers-grid">{referenceResearchers.map(r=><article class="ref-researcher">
    <div><span class="ref-number">{r.year}</span><h3>{r.name}</h3></div>
    <p>{L(r.work,lang)}</p>
    <div class="ref-researcher-links">
     <a href={r.source} rel="noopener noreferrer" target="_blank">{fr?'Consulter la publication d’origine':'Original publication'} ↗</a>
     {r.topics.slice(0,1).map(slug=>{const t=topic(slug);return t?<a href={'/'+lang+'/encyclopedie/'+slug+'/'}>{L(t.title,lang)} ↗</a>:null})}
    </div>
  </article>)}</div>
 </div>
 </div></section>}
{type==='chronologie' && <section class="ref-body section"><div class="wrap">
 <div class="ref-section-heading"><span class="eyebrow">{fr?'REPÈRES HISTORIQUES':'HISTORICAL MILESTONES'}</span>
  <h2>{fr?'Des documents hypertextes aux agents du Web.':'From hypertext to Web agents.'}</h2><p>{fr?'Une chronologie documentaire : dates de travaux ou d’annonces, avec sources originales. Les perspectives futures et projections ne sont pas présentées comme des faits acquis.':'A documentary chronology of research and announcements with original sources. Future projections are not presented as established facts.'}</p></div>
 <ol class="ref-timeline">{referenceTimeline.map((event,index)=><li class="ref-timeline-item">
  <div class="ref-timeline-date"><span>{event.year}</span><small>{String(index+1).padStart(2,'0')}</small></div>
  <div class="ref-timeline-body"><h3>{L(event.title,lang)}</h3><p>{L(event.text,lang)}</p><a href={event.url} target="_blank" rel="noopener noreferrer">{fr?'Document historique':'Historical source'} ↗</a></div>
 </li>)}</ol></div></section>}
{type==='faq' && <section class="ref-body section"><div class="wrap">
 <div class="ref-section-heading"><span class="eyebrow">{fr?'12 QUESTIONS DE RÉFÉRENCE':'12 REFERENCE QUESTIONS'}</span><h2>{fr?'Des réponses traçables, pas des slogans.':'Traceable answers, not slogans.'}</h2><p>{fr?'Chaque réponse est accompagnée d’une source à consulter. Les formulations sont des synthèses éditoriales et ne se substituent pas aux spécifications originales.':'Every answer links to a source for independent checking. These are editorial summaries, not substitutes for the original specifications.'}</p></div>
 <div class="ref-faq-list">{referenceFaq.map((item,index)=><details class="ref-faq" open={index===0}>
  <summary><span>{String(index+1).padStart(2,'0')}</span><strong>{L(item.question,lang)}</strong><span class="ref-faq-plus" aria-hidden="true">+</span></summary>
  <div class="ref-faq-answer"><p>{L(item.answer,lang)}</p><a href={item.source} target="_blank" rel="noopener noreferrer">{fr?'Vérifier la source primaire':'Check the primary source'} ↗</a></div>
 </details>)}</div></div></section>}
<section class="ref-next section"><div class="wrap">
 <div><span class="eyebrow">{fr?'POURSUIVRE LA CONSULTATION':'CONTINUE THE REFERENCE'}</span><h2>{fr?'Des documents liés, plutôt que des silos.':'Connected evidence, not isolated pages.'}</h2><p>{fr?'Retrouvez chaque concept dans l’encyclopédie, explorez les technologies et consultez les sources originales avant de tirer une conclusion.':'Use the encyclopedia to cross-reference concepts, explore technologies and inspect original sources before drawing conclusions.'}</p></div>
 <div class="ref-next-links">
  <a href={'/'+lang+'/encyclopedie/'}>{fr?'Encyclopédie':'Encyclopedia'} ↗</a>
  <a href={'/'+lang+'/ressources/'}>{fr?'Bibliographie et sources':'Bibliography and sources'} ↗</a>
  <a href={'/'+lang+'/outils/'}>{fr?'AI Tools':'AI Tools'} ↗</a>
  <a href={'/'+lang+'/observatoire/'}>{fr?'Observatoire':'Observatory'} ↗</a>
 </div>
</div></section>
