---
import {atlas} from '../data/atlas.js';
const {lang='fr'}=Astro.props;const fr=lang==='fr';
const shortcuts=[
 {key:'encyclopedie',icon:'◇',title:fr?'Encyclopédie':'Encyclopedia',desc:fr?'Articles et dossiers de référence':'Reference articles and dossiers',number:atlas.topics.length},
 {key:'outils',icon:'◈',title:fr?'Outils IA':'AI tools',desc:fr?'Solutions à comparer':'Solutions to explore',number:atlas.catalog.length},
 {key:'ressources',icon:'▤',title:fr?'Sources':'Sources',desc:fr?'Normes et documents':'Standards and documents',number:atlas.sources.length},
 {key:'glossaire',icon:'Aa',title:fr?'Glossaire':'Glossary',desc:fr?'Termes bilingues':'Bilingual terms',number:atlas.glossary.length}
];
---
<section class="atlas-home-overview"><div class="wrap">
  <div class="atlas-home-top"><div><span class="eyebrow"><span class="atlas-beacon"></span> THE WEBAI ATLAS</span><h2>{fr?'Un atlas de référence, des sources aux technologies.':'A reference atlas from sources to technologies.'}</h2><p>{fr?'Une encyclopédie, un annuaire d’outils, des documents officiels et un glossaire reliés entre eux : chaque information ouvre sur ses origines.':'An encyclopedia, tool directory, official documents and an interconnected glossary: every entry links back to its origins.'}</p></div>
    <a class="atlas-home-search" href={'/'+lang+'/recherche/'}><span aria-hidden="true">⌕</span> {fr?'Rechercher dans WebAI':'Search WebAI'} <kbd>↗</kbd></a></div>
  <div class="atlas-home-shortcuts">{shortcuts.map(x=><a href={'/'+lang+'/'+x.key+'/'} class="atlas-shortcut"><span class="atlas-shortcut-head"><span class="atlas-shortcut-icon">{x.icon}</span><span class="atlas-shortcut-number">{x.number}</span></span><strong>{x.title}</strong><small>{x.desc}</small><span class="atlas-shortcut-arrow" aria-hidden="true">↗</span></a>)}</div>
  <div class="atlas-persona"><div><span class="eyebrow">{fr?'NAVIGUER DANS LA RÉFÉRENCE':'NAVIGATE THE REFERENCE'}</span><strong>{fr?'Des entrées complémentaires selon la question étudiée':'Connected paths for different research questions'}</strong></div>
  <div class="atlas-persona-links"><a href={'/'+lang+'/concept/'}>{fr?'Concept':'Concept'} ↗</a><a href={'/'+lang+'/standards/'}>{fr?'Normes':'Standards'} ↗</a><a href={'/'+lang+'/acteurs/'}>{fr?'Acteurs':'Organizations'} ↗</a><a href={'/'+lang+'/chronologie/'}>{fr?'Chronologie':'Timeline'} ↗</a></div></div>
<div class="atlas-action-ribbon">
 <div><span class="eyebrow">{fr?'OUTILS D’AIDE À LA DÉCISION':'DECISION SUPPORT'}</span><strong>{fr?'Documents, comparaisons et vérification':'Documents, comparisons and verification'}</strong></div>
 <div class="atlas-action-ribbon-links"><a href={'/'+lang+'/comparateur/'}>{fr?'Comparer les outils':'Compare tools'} ↗</a><a href={'/'+lang+'/guides/'}>{fr?'Guides techniques':'Technical guides'} ↗</a><a href={'/'+lang+'/fiche-verification/'}>{fr?'Vérifier une source':'Check a source'} ↗</a></div>
 </div></div></section>
<section class="atlas-home-feature"><div class="wrap atlas-feature-grid">
  <div><span class="eyebrow">{fr?'EXPÉRIMENTATION TECHNIQUE':'TECHNICAL EXPLORATION'}</span><h2>{fr?'Un laboratoire pour examiner les mécanismes.':'A laboratory for inspecting mechanisms.'}</h2><p>{fr?'Quinze modules pour analyser du JSON, documenter les schémas MCP, contrôler du HTML et des sitemaps, comparer des données ou examiner des preuves. Ils s’exécutent localement et signalent leurs limites.':'Fifteen browser-only modules for JSON analysis, MCP tool schemas, HTML and sitemap checks, data comparison and evidence review. They run locally and explain their limitations.'}</p><a href={'/'+lang+'/laboratoire/'} class="atlas-pill-cta">{fr?'Ouvrir WebAI Studio':'Open WebAI Studio'} ↗</a></div>
  <div class="atlas-feature-visual" aria-hidden="true"><div class="atlas-feature-head"><span></span><span></span><span></span><strong>WebAI / Studio</strong></div><div class="atlas-feature-lines"><span>01 · PROMPT</span><span class="on">02 · VALIDATE JSON ✓</span><span>03 · MEASURE</span><span>04 · CONTRAST</span></div><div class="atlas-feature-glow">✳</div></div>
</div></section>
