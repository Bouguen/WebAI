---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, nav, references } from '../../data/site.js';
export function getStaticPaths() { return ['fr','en'].map(lang => ({params:{lang}})); }
const { lang } = Astro.params;
const t = copy[lang];
---
<BaseLayout lang={lang}>
  <section class="hero">
    <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow"><span class="eyebrow-dot"></span>{t.overview}</span>
        <h1>{t.headline}<br /><span class="gradient-text">{t.headlineAccent}</span></h1>
        <p class="hero-lede">{t.lede}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={'/' + lang + '/decouvrir/'}>{t.primary}<span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="#domains">{t.secondary}<span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-status"><span class="status-dot" aria-hidden="true"></span>{t.preview}</div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-grid"></div>
        <div class="neural-ring neural-ring-one"></div><div class="neural-ring neural-ring-two"></div>
        <div class="visual-center"><div class="visual-mark">✳</div><strong>Web<span>AI</span></strong><small>KNOWLEDGE NETWORK</small></div>
        <div class="visual-node node-one"><span>◇</span><b>GENERATE</b></div>
        <div class="visual-node node-two"><span>⌘</span><b>CONNECT</b></div>
        <div class="visual-node node-three"><span>◉</span><b>DISCOVER</b></div>
        <div class="visual-node node-four"><span>✓</span><b>VERIFY</b></div>
      </div>
    </div>
  </section>
  <section class="section section-domains" id="domains">
    <div class="wrap">
      <div class="section-heading"><div><span class="eyebrow">{t.discoverKicker}</span><h2>{t.discoverTitle}</h2><p>{t.discoverIntro}</p></div><a class="text-link" href={'/' + lang + '/recherche/'}>{t.search} <span aria-hidden="true">↗</span></a></div>
      <div class="domain-grid">
        {nav.map((item, index) => <article class:list={['domain-card', index===0 && 'domain-featured']}>
          <div class="domain-top"><span class="domain-glyph" aria-hidden="true">{item.glyph}</span><span class="domain-index">0{index+1}</span></div>
          <h3>{t.topics[item.id].title}</h3>
          <p>{t.topics[item.id].subtitle}</p>
          <a href={'/' + lang + '/' + item.id + '/'} class="card-link">{t.open} <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>
  <section class="section layer-section">
    <div class="wrap">
      <div class="section-heading narrow"><div><span class="eyebrow">{t.insightKicker}</span><h2>{t.insightTitle}</h2><p>{t.insightIntro}</p></div></div>
      <div class="layer-grid">{t.layers.map((layer,i) => <div class="layer-card"><span class="layer-step">0{i+1}</span><div class="layer-graphic" aria-hidden="true"><span>{['✧','◎','⌘','⬡'][i]}</span></div><h3>{layer.name}</h3><b>{layer.line}</b><p>{layer.description}</p></div>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="wrap trust-grid">
      <div class="trust-art" aria-hidden="true"><div class="trust-art-inner"><span>✓</span><span>Source</span><span>↗</span></div></div>
      <div class="trust-content"><span class="eyebrow">EDITORIAL FIRST</span><h2>{t.trustTitle}</h2><p>{t.trustText}</p><a class="text-link" href={'/' + lang + '/verifier/'}>{t.trustLink}<span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section sources-section">
    <div class="wrap"><div class="section-heading narrow"><div><h2>{t.sourcesTitle}</h2><p>{t.sourcesText}</p></div></div>
    <div class="references-grid">{references.map(ref => <a href={ref.url} target="_blank" rel="noopener noreferrer" class="reference-card"><span>{ref.name}</span><span aria-hidden="true">↗</span></a>)}</div>
    </div>
  </section>
</BaseLayout>
