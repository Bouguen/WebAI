---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasSpotlight from '../../components/AtlasSpotlight.astro';
import DossierHighlight from '../../components/DossierHighlight.astro';
import SpatialHero from '../../components/SpatialHero.astro';
import ReferenceLandscape from '../../components/ReferenceLandscape.astro';
import {referenceNav} from '../../data/referenceContent.js';
import {copy, references} from '../../data/site.js';
export function getStaticPaths() { return ['fr','en'].map(lang => ({params:{lang}})); }
const { lang } = Astro.params;
const t = copy[lang];
const refSummaries={
 fr:{concept:'Cadre, définitions, principes et frontières conceptuelles.',technologies:'Modèles, recherche, agents, Web sémantique, inférence locale.',standards:'Statuts, protocoles, interopérabilité et textes originaux.',outils:'51 logiciels et plateformes documentés avec sources.',secteurs:'Dix domaines d’application et scénarios contextualisés.',publications:'Études scientifiques, méthodes, limites et bibliographie.',acteurs:'Organismes, projets, normalisation et initiatives majeures.',observatoire:'Versions, jalons, travaux et méthodes de vérification.'},
 en:{concept:'Scope, definitions, principles and conceptual boundaries.',technologies:'Models, search, agents, semantic Web and local inference.',standards:'Status, protocols, interoperability and original specifications.',outils:'51 documented software and platform profiles.',secteurs:'Ten fields of application and contextual case studies.',publications:'Scientific studies, methods, limitations and bibliography.',acteurs:'Organizations, standards projects and key initiatives.',observatoire:'Versions, milestones, research and verification methods.'}
};
---
<BaseLayout lang={lang}>
  <section class="hero">
    <div class="hero-ambient" aria-hidden="true">
      <span class="ambient-halo ambient-halo-a"></span>
      <span class="ambient-halo ambient-halo-b"></span>
      <span class="ambient-stream ambient-stream-a"></span>
      <span class="ambient-stream ambient-stream-b"></span>
      <span class="ambient-stream ambient-stream-c"></span>
      <span class="ambient-spark ambient-spark-a"></span>
      <span class="ambient-spark ambient-spark-b"></span>
      <span class="ambient-spark ambient-spark-c"></span>
    </div>
    <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow"><span class="eyebrow-dot"></span>{t.overview}</span>
        <h1 class="webai-signal-title"><span class="signal-title-base">{t.headline}</span><span class="signal-title-accent gradient-text">{t.headlineAccent}</span><span class="signal-title-beacon" aria-hidden="true">✧</span></h1>
        <p class="hero-lede">{t.lede}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={'/' + lang + '/technologies/'}>{t.primary}<span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="#domains">{t.secondary}<span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-status"><span class="status-dot" aria-hidden="true"></span>{t.preview}</div>
      </div>
      <SpatialHero lang={lang} />
    </div>
  </section>
  <section class="section section-domains" id="domains">
    <div class="wrap">
      <div class="section-heading"><div><span class="eyebrow">{t.discoverKicker}</span><h2>{t.discoverTitle}</h2><p>{t.discoverIntro}</p></div><a class="text-link" href={'/' + lang + '/encyclopedie/'}>{lang==='fr'?'Encyclopédie':'Encyclopedia'} <span aria-hidden="true">↗</span></a></div>
      <div class="domain-grid">
        {referenceNav.map((item, index) => <article class:list={['domain-card', index===0 && 'domain-featured']}>
          <div class="domain-top"><span class="domain-glyph" aria-hidden="true">{item.glyph}</span><span class="domain-index">0{index+1}</span></div>
          <h3>{item.title[lang]}</h3>
          <p>{refSummaries[lang][item.id]}</p>
          <a href={'/' + lang + '/' + item.id + '/'} class="card-link">{t.open} <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>
  <ReferenceLandscape lang={lang} />
  <AtlasSpotlight lang={lang} />
  <DossierHighlight lang={lang} />
  <section class="section">
    <div class="wrap trust-grid">
      <div class="trust-art" aria-hidden="true"><div class="trust-art-inner"><span>✓</span><span>Source</span><span>↗</span></div></div>
      <div class="trust-content"><span class="eyebrow">EDITORIAL FIRST</span><h2>{t.trustTitle}</h2><p>{t.trustText}</p><a class="text-link" href={'/' + lang + '/verifier/'}>{t.trustLink}<span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section sources-section">
    <div class="wrap"><div class="section-heading narrow"><div><h2>{t.sourcesTitle}</h2><p>{t.sourcesText}</p></div></div>
    <div class="references-grid">{references.map(ref => <a href={ref.url} target="_blank" rel="noopener noreferrer" class="reference-card"><span>{ref.name}</span><span aria-hidden="true">↗</span></a>)}</div>
    </div>
  </section>
</BaseLayout>
