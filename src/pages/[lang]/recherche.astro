---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {copy,nav} from '../../data/site.js';
import {atlas,localized as L} from '../../data/atlas.js';
export function getStaticPaths(){return ['fr','en'].map(lang=>({params:{lang}}));}
const {lang}=Astro.params;const fr=lang==='fr';const t=copy[lang];
const entries=[
 ...nav.map(x=>({title:t.topics[x.id].title,desc:t.topics[x.id].subtitle,href:'/'+lang+'/'+x.id+'/',type:'section'})),
 ...atlas.topics.map(x=>({title:L(x.title,lang),desc:L(x.summary,lang),href:'/'+lang+'/encyclopedie/'+x.slug+'/',type:'article'})),
 ...atlas.catalog.map(x=>({title:x.name,desc:L(x.desc,lang),href:x.url,type:'outil',external:true})),
 ...atlas.sources.map(x=>({title:x.name,desc:L(x.desc,lang),href:x.url,type:'source',external:true})),
 ...atlas.glossary.map(x=>({title:lang==='fr'?x.fr:x.en,desc:L(x.definition,lang),href:'/'+lang+'/glossaire/',type:'terme'}))
];
---
<BaseLayout lang={lang} title={fr?'Recherche transversale':'Cross-portal discovery'}>
<section class="atlas-hero"><div class="wrap">
 <div class="atlas-breadcrumb"><a href={'/'+lang+'/'}>WebAI</a><span>/</span>{fr?'Recherche':'Search'}</div>
 <span class="atlas-eyebrow"><span class="atlas-beacon"></span>WEBAI ATLAS · {fr?'RECHERCHE LOCALE':'LOCAL DISCOVERY'}</span>
 <div class="atlas-heading"><div><h1>{fr?'Tout WebAI, en un endroit.':'All of WebAI, one search.'}</h1><p>{fr?'Rechercher parmi les rubriques, notions, outils, sources et termes disponibles dans cette préversion.':'Search the sections, explainers, tools, sources and terms included in this preview.'}</p></div><div class="atlas-hero-figure" aria-hidden="true"><div class="atlas-fig-orbit"></div><div class="atlas-fig-center">⌕</div></div></div>
</div></section>
<section class="section"><div class="wrap search-page atlas-global-search">
 <div class="atlas-controls"><div class="atlas-controls-top"><h2>{fr?'Rechercher les ressources':'Search resources'}</h2><span class="atlas-count"><b id="search-count">{entries.length}</b> {fr?'résultats':'results'}</span></div>
 <div class="atlas-filter-line"><label class="atlas-search-label"><span aria-hidden="true">⌕</span><input id="global-query" type="search" autocomplete="off" placeholder={fr?'Mot-clé, protocole, ressource, outil…':'Keyword, protocol, resource, tool…'}/></label>
 <label class="atlas-select-label"><span class="sr-only">{fr?'Type':'Type'}</span><select id="global-type"><option value="all">{fr?'Tous les types':'All types'}</option>
 {['section','article','outil','source','terme'].map(x=><option value={x}>{({section:fr?'Rubriques':'Sections',article:fr?'Articles':'Articles',outil:fr?'Outils':'Tools',source:fr?'Sources':'Sources',terme:fr?'Glossaire':'Glossary'})[x]}</option>)}</select></label></div></div>
 <div id="fulltext-region" class="fulltext-region" hidden><div class="fulltext-head"><div><span class="eyebrow">PAGEFIND · {fr?'RECHERCHE PLEIN TEXTE':'FULL-TEXT SEARCH'}</span><h2>{fr?'Dans les pages WebAI':'Across WebAI pages'}</h2></div><span id="fulltext-status" aria-live="polite"></span></div><div id="fulltext-results" class="fulltext-results"></div></div>
 <div class="atlas-catalog-results-title"><h2>{fr?'Répertoire des contenus et ressources':'Content and resource directory'}</h2><p>{fr?'Filtrez par type pour retrouver les outils, références et définitions.':'Filter by type to find tools, references and definitions.'}</p></div>
 <div class="search-results">{entries.map(e=><article class="search-result" data-search-item data-type={e.type} data-match={(e.title+' '+e.desc+' '+e.type).toLowerCase()}><div class="search-result-icon" aria-hidden="true">{e.type==='outil'?'◈':e.type==='article'?'◇':e.type==='source'?'▤':e.type==='terme'?'Aa':'✧'}</div><div><span class="atlas-item-kind">{e.type}</span><h2>{e.title}</h2><p>{e.desc}</p><a href={e.href} target={e.external?'_blank':undefined} rel={e.external?'noopener noreferrer':undefined}>{fr?'Consulter':'Open'} ↗</a></div></article>)}</div>
 <p class="atlas-empty" id="global-no-results" hidden>{fr?'Aucun résultat. Essayez un autre terme.':'No results. Try another term.'}</p>
 <p class="atlas-disclaimer">{fr?'Filtrage local de la collection actuelle. Le moteur sémantique et les contenus scientifiques approfondis sont prévus après validation éditoriale.':'Local filtering of the current collection. Semantic search and the full scientific corpus are planned after editorial review.'}</p>
</div></section>
<script is:inline>
const input=document.getElementById('global-query'),select=document.getElementById('global-type'),count=document.getElementById('search-count'),empty=document.getElementById('global-no-results');
const cards=[...document.querySelectorAll('[data-search-item]')];
const norm=s=>(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const run=()=>{let n=0;cards.forEach(card=>{const ok=norm(card.dataset.match).includes(norm(input.value.trim()))&&(select.value==='all'||card.dataset.type===select.value);card.hidden=!ok;if(ok)n++;});count.textContent=String(n);empty.hidden=n!==0;};
input.addEventListener('input',run);select.addEventListener('change',run);
const initial=new URLSearchParams(window.location.search).get('q');if(initial){input.value=initial;run();}
const fullRegion=document.getElementById('fulltext-region');
const fullStatus=document.getElementById('fulltext-status');
const fullResults=document.getElementById('fulltext-results');
let indexPromise=null,searchSeq=0;
const getIndex=()=>{if(!indexPromise)indexPromise=import('/pagefind/pagefind.js').catch(()=>null);return indexPromise;};
function add(tag,cls,content,parent){const n=document.createElement(tag);if(cls)n.className=cls;if(content!==undefined)n.textContent=content;parent.appendChild(n);return n;}
async function fullSearch(){
 const query=input.value.trim(),seq=++searchSeq;
 if(query.length<2){fullRegion.hidden=true;fullResults.replaceChildren();return;}
 fullRegion.hidden=false;fullStatus.textContent=document.documentElement.lang==='fr'?'Recherche en cours…':'Searching…';
 const index=await getIndex();if(seq!==searchSeq)return;
 if(!index){fullStatus.textContent=document.documentElement.lang==='fr'?'Index plein texte indisponible en mode développement.':'Full-text index unavailable in development.';return;}
 try{
  const match=await index.search(query);if(seq!==searchSeq)return;
  const top=(match?.results||[]).slice(0,8);
  const details=await Promise.all(top.map(x=>x.data()));if(seq!==searchSeq)return;
  fullResults.replaceChildren();
  details.forEach(d=>{
    const a=add('a','fulltext-card',undefined,fullResults);
    if(typeof d.url==='string'&&d.url.startsWith('/'))a.href=d.url;else a.href='/';
    add('strong','',d.meta?.title||d.title||d.url,a);
    add('span','',d.plain_excerpt||'',a);
    add('em','',document.documentElement.lang==='fr'?'Lire la page ↗':'Read page ↗',a);
  });
  fullStatus.textContent=String(details.length)+(document.documentElement.lang==='fr'?' résultat(s) affiché(s)':' result(s) displayed');
 }catch(e){fullResults.replaceChildren();fullStatus.textContent=document.documentElement.lang==='fr'?'Recherche indisponible momentanément.':'Search temporarily unavailable.';}
}
let timer;
input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(fullSearch,200);});
if(initial)fullSearch();

</script>
</BaseLayout>
